# ── Docker Compose — credenciales de base de datos ────────────────────────
# Estas variables las usa docker-compose para crear el contenedor de Postgres.
# DB_USER y DB_PASSWORD se componen dentro de DATABASE_URL abajo.
DB_USER=hotel_user
DB_PASSWORD=hotel_password_dev

# ── Base de datos ──────────────────────────────────────────────────────────
# Para desarrollo local (fuera de Docker): host = localhost
# Dentro de Docker Compose el host es "db" (se inyecta automáticamente)
DATABASE_URL=postgresql://hotel_user:hotel_password_dev@localhost:5432/hotel_db

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ────────────────────────────────────────────────────────────────────
# Mínimo 64 caracteres. Generar con: openssl rand -base64 64
JWT_SECRET=

# ── Entorno ────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── WhatsApp Business API (Meta) ───────────────────────────────────────────
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Niubiz (pagos Perú) ────────────────────────────────────────────────────
NIUBIZ_MERCHANT_ID=
NIUBIZ_API_KEY=

# ── Stripe (pagos internacional) ───────────────────────────────────────────
STRIPE_SECRET_KEY=

# ── SUNAT (facturación electrónica) ───────────────────────────────────────
SUNAT_RUC=
SUNAT_USUARIO_SOL=
SUNAT_CLAVE_SOL=
SUNAT_CERT_PATH=
SUNAT_CERT_PASSWORD=
SUNAT_MODO=beta

# ── AI Service ─────────────────────────────────────────────────────────────
# Para desarrollo local apunta a localhost; en Docker Compose se sobreescribe
# automáticamente con http://ai-service:8001
IA_SERVICE_URL=http://localhost:8001

# ── n8n ────────────────────────────────────────────────────────────────────
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=
# Secret compartido entre el backend y n8n para validar webhooks internos
N8N_WEBHOOK_SECRET=

# ── Anthropic (chatbot concierge) ──────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Revenue management ─────────────────────────────────────────────────────
TARIFA_MINIMA_SIMPLE=80
TARIFA_MINIMA_DOBLE=120
TARIFA_MINIMA_SUITE=200
MAX_INCREMENTO_TARIFA_PCT=150
OCUPACION_UMBRAL_ALTO=75

# ── CRM ────────────────────────────────────────────────────────────────────
LTV_UMBRAL_VIP=2000
MESES_INACTIVIDAD_REACTIVAR=18
