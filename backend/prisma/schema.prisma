generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum RolPersonal {
  ADMIN
  RECEPCIONISTA
  HOUSEKEEPING
  MANTENIMIENTO
  GERENTE
}

enum TipoHabitacion {
  SIMPLE
  DOBLE
  SUITE
  FAMILIAR
}

enum EstadoHabitacion {
  DISPONIBLE
  OCUPADA
  RESERVADA
  MANTENIMIENTO
  LIMPIEZA
  FUERA_DE_SERVICIO
}

enum TipoDocumento {
  DNI
  PASAPORTE
  CE
  RUC
  DOC_EXTRANJERO
}

enum SegmentoHuesped {
  NUEVO
  NORMAL
  RECURRENTE
  OCASIONAL
  VIP
  CORPORATIVO
  INACTIVO
}

enum IdiomaPreferido {
  ES
  EN
  PT
  FR
  DE
}

enum EstadoReserva {
  CONFIRMADA
  CHECKIN_REALIZADO
  CHECKOUT_REALIZADO
  CANCELADA
  NO_SHOW
}

enum CanalReserva {
  DIRECTO
  BOOKING_COM
  EXPEDIA
  WHATSAPP
  TELEFONO
  AIRBNB
}

enum TipoFolioItem {
  HABITACION
  SERVICIO
  MINIBAR
  RESTAURANTE
  LAVANDERIA
  OTRO
  TELEFONO
  SPA
  PARKING
  SERVICIO_EXTRA
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  NIUBIZ
  STRIPE
  TARJETA_CREDITO
  TARJETA_DEBITO
  YAPE
  PLIN
}

enum EstadoPago {
  PENDIENTE
  COMPLETADO
  FALLIDO
  REEMBOLSADO
}

enum TipoComprobante {
  BOLETA
  FACTURA
}

enum CanalSync {
  BOOKING_COM
  EXPEDIA
  AIRBNB
}

enum TipoEventoSync {
  RESERVA_NUEVA
  MODIFICACION
  CANCELACION
  DISPONIBILIDAD
}

enum EstadoSync {
  PROCESADO
  ERROR
  PENDIENTE
}

enum CanalReview {
  DIRECTO
  BOOKING_COM
  EXPEDIA
  GOOGLE
  TRIPADVISOR
}

enum SentimientoReview {
  POSITIVO
  NEUTRAL
  NEGATIVO
}

enum FuenteTarifa {
  MANUAL
  AI
  CHANNEL_MANAGER
}

enum TipoCampana {
  EMAIL
  WHATSAPP
  AMBOS
}

enum SegmentoCampana {
  NORMAL
  VIP
  CORPORATIVO
  TODOS
}

enum EstadoCampana {
  BORRADOR
  PROGRAMADA
  ENVIADA
  PAUSADA
}

enum TipoTemporada {
  TEMPORADA_ALTA
  TEMPORADA_BAJA
  FIN_DE_SEMANA
  EVENTO_ESPECIAL
  ESTADIA_LARGA
}

enum TipoTurno {
  DIA
  NOCHE
}

enum EstadoTurno {
  ABIERTO
  CERRADO
}

enum TipoAsientoContable {
  ingreso
  egreso
  ajuste
  apertura
  cierre
}

// ─── Modelos ──────────────────────────────────────────────────────────────────

/// Staff del hotel (recepcionistas, housekeeping, gerentes, etc.)
model Personal {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre        String      @db.VarChar(100)
  apellido      String      @db.VarChar(100)
  email         String      @unique @db.VarChar(255)
  password_hash String      @db.VarChar(255)
  rol           RolPersonal
  /// Rol granular nuevo (roles.codigo). Reemplaza `rol` una vez completada la migración a permisos por local.
  rol_id        String?     @db.Uuid
  empresa_id    String?     @db.Uuid
  /// true = superadmin de la plataforma SaaS (dueño de Hotelia), no de una empresa cliente
  es_superadmin_plataforma Boolean @default(false)
  activo        Boolean     @default(true)
  created_at    DateTime    @default(now()) @db.Timestamptz(3)
  updated_at    DateTime    @updatedAt @db.Timestamptz(3)

  reservas     Reserva[]
  campanas     CampanaCrm[]
  folio_items  FolioItem[]
  pagos        Pago[]
  turnos       Turno[]
  gastos_caja_registrados GastoCaja[] @relation("gastos_registrado_por")
  rol_nuevo       Rol?           @relation(fields: [rol_id], references: [id])
  empresa         Empresa?       @relation(fields: [empresa_id], references: [id])
  usuario_locales UsuarioLocal[]

  @@index([rol_id])
  @@index([empresa_id])
  @@map("personal")
}

/// Tipos de habitación personalizados (además de los predefinidos en enum TipoHabitacion)
model TipoHabitacionCustom {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre      String   @db.VarChar(50)
  descripcion String?  @db.Text
  color_mapa  String   @default("#3B82F6") @db.VarChar(7)
  /// NULL = plantilla compartida por toda la cadena; no-NULL = tipo custom de un local
  local_id    String?  @db.Uuid
  activo      Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz(3)

  habitaciones Habitacion[]
  local        Local?     @relation(fields: [local_id], references: [id])

  @@index([local_id])
  @@map("tipos_habitacion")
}

/// Habitaciones del hotel
model Habitacion {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  numero            String           @unique @db.VarChar(10)
  tipo              TipoHabitacion
  piso              Int
  capacidad         Int              @default(2)
  capacidad_adultos Int?
  capacidad_ninos   Int              @default(0)
  tarifa_base       Decimal          @db.Decimal(10, 2)
  tarifa_minima     Decimal?         @db.Decimal(10, 2)
  tarifa_maxima     Decimal?         @db.Decimal(10, 2)
  moneda_tarifa     String           @default("PEN") @db.VarChar(3)
  estado            EstadoHabitacion @default(DISPONIBLE)
  descripcion       String?          @db.Text
  amenidades        Json?
  fotos             Json             @default("[]")
  visible_otas      Boolean          @default(true)
  tipo_custom_id    String?          @db.Uuid
  local_id          String           @db.Uuid
  created_at        DateTime         @default(now()) @db.Timestamptz(3)
  updated_at        DateTime         @updatedAt @db.Timestamptz(3)

  tipo_custom           TipoHabitacionCustom?  @relation(fields: [tipo_custom_id], references: [id])
  local                 Local                  @relation(fields: [local_id], references: [id])
  reservas              Reserva[]
  tarifas_historial     TarifaHistorial[]
  alertas_mantenimiento AlertaMantenimiento[]

  @@index([estado])
  @@index([local_id, estado])
  @@map("habitaciones")
}

/// Huéspedes (clientes del hotel)
model Huesped {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre                String          @db.VarChar(100)
  apellido              String          @db.VarChar(100)
  email                 String?         @unique @db.VarChar(255)
  telefono              String?         @db.VarChar(20)
  tipo_documento        TipoDocumento
  numero_documento      String          @unique @db.VarChar(20)
  nacionalidad          String?         @db.VarChar(100)
  fecha_nacimiento      DateTime?       @db.Date
  fecha_vencimiento_doc DateTime?       @db.Date
  ltv                   Decimal         @default(0) @db.Decimal(12, 2)
  segmento              SegmentoHuesped @default(NUEVO)
  notas                 String?         @db.Text
  idioma_preferido      IdiomaPreferido @default(ES)
  preferencias          Json?
  activo                Boolean         @default(true)
  created_at            DateTime        @default(now()) @db.Timestamptz(3)
  updated_at            DateTime        @updatedAt @db.Timestamptz(3)

  reservas            Reserva[]
  reviews             Review[]
  concierge_mensajes  ConciergeMessage[]

  @@index([numero_documento])
  @@map("huespedes")
}

/// Reservas (núcleo del PMS — protegida con EXCLUDE USING gist anti-overbooking)
model Reserva {
  id                      String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo                  String           @unique @db.VarChar(20)
  huesped_id              String           @db.Uuid
  habitacion_id           String           @db.Uuid
  fecha_entrada           DateTime         @db.Date
  fecha_salida            DateTime         @db.Date
  estado                  EstadoReserva    @default(CONFIRMADA)
  canal                   CanalReserva     @default(DIRECTO)
  tarifa_acordada         Decimal          @db.Decimal(10, 2)
  adultos                 Int              @default(1)
  ninos                   Int              @default(0)
  notas                   String?          @db.Text
  idempotency_key         String?          @unique @db.VarChar(100)
  personal_id             String?          @db.Uuid
  qr_token                String?          @db.Text
  qr_generado_en          DateTime?        @db.Timestamptz(3)
  tipo_comprobante        TipoComprobante?
  datos_facturacion       Json?
  canal_envio_comprobante String?          @default("whatsapp") @db.VarChar(20)
  created_at              DateTime         @default(now()) @db.Timestamptz(3)
  updated_at              DateTime         @updatedAt @db.Timestamptz(3)

  huesped    Huesped    @relation(fields: [huesped_id], references: [id])
  habitacion Habitacion @relation(fields: [habitacion_id], references: [id])
  personal   Personal?  @relation(fields: [personal_id], references: [id])

  folio_items        FolioItem[]
  pagos              Pago[]
  canal_sync_log     CanalSyncLog[]
  review             Review?
  concierge_mensajes ConciergeMessage[]
  comprobante        Comprobante?

  @@index([huesped_id])
  @@index([habitacion_id])
  @@index([fecha_entrada, fecha_salida])
  @@index([estado])
  @@map("reservas")
}

/// Ítems del folio de cada reserva (cargos por noche, servicios, extras)
model FolioItem {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reserva_id      String        @db.Uuid
  descripcion     String        @db.VarChar(255)
  tipo            TipoFolioItem @default(HABITACION)
  cantidad        Int           @default(1)
  precio_unitario Decimal       @db.Decimal(10, 2)
  fecha           DateTime      @db.Date
  anulado         Boolean       @default(false)
  personal_id     String?       @db.Uuid
  notas           String?       @db.Text
  created_at      DateTime      @default(now()) @db.Timestamptz(3)

  reserva  Reserva   @relation(fields: [reserva_id], references: [id])
  personal Personal? @relation(fields: [personal_id], references: [id])

  @@index([reserva_id])
  @@map("folio_items")
}

/// Pagos y comprobantes (Niubiz, Stripe, efectivo, SUNAT CDR)
model Pago {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reserva_id         String           @db.Uuid
  monto              Decimal          @db.Decimal(12, 2)
  moneda             String           @default("PEN") @db.VarChar(3)
  metodo             MetodoPago
  estado             EstadoPago       @default(PENDIENTE)
  referencia_externa String?          @db.VarChar(255)
  numero_comprobante String?          @db.VarChar(50)
  tipo_comprobante   TipoComprobante?
  sunat_cdr          String?          @db.Text
  notas              String?          @db.Text
  personal_id        String?          @db.Uuid
  created_at         DateTime         @default(now()) @db.Timestamptz(3)
  updated_at         DateTime         @updatedAt @db.Timestamptz(3)

  reserva  Reserva   @relation(fields: [reserva_id], references: [id])
  personal Personal? @relation(fields: [personal_id], references: [id])

  @@index([reserva_id])
  @@map("pagos")
}

/// Reglas de temporada para ajuste de tarifas
model ReglaTemporada {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre                String        @db.VarChar(100)
  tipo                  TipoTemporada
  fecha_inicio          DateTime?     @db.Date
  fecha_fin             DateTime?     @db.Date
  ajuste_porcentaje     Decimal       @db.Decimal(5, 2)
  estadia_minima_noches Int?
  aplica_a_tipos        Json          @default("[]")
  /// NULL = regla global de cadena; no-NULL = override de un local
  local_id              String?       @db.Uuid
  activo                Boolean       @default(true)
  created_at            DateTime      @default(now()) @db.Timestamptz(3)

  local Local? @relation(fields: [local_id], references: [id])

  @@index([local_id])
  @@map("reglas_temporada")
}

/// Log de sincronización con canales externos (Booking.com, Expedia)
model CanalSyncLog {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  canal           CanalSync
  tipo_evento     TipoEventoSync
  payload_entrada Json
  payload_salida  Json?
  reserva_id      String?        @db.Uuid
  estado          EstadoSync     @default(PENDIENTE)
  idempotency_key String         @unique @db.VarChar(100)
  error_mensaje   String?        @db.Text
  /// Sin FK confiable cuando reserva_id es NULL (eventos de OTA sin reserva local, ej. bloqueo de calendario) — columna directa
  local_id        String?        @db.Uuid
  created_at      DateTime       @default(now()) @db.Timestamptz(3)

  reserva Reserva? @relation(fields: [reserva_id], references: [id])
  local   Local?   @relation(fields: [local_id], references: [id])

  @@index([canal, estado])
  @@index([local_id])
  @@map("canal_sync_log")
}

/// Reseñas de huéspedes (propias y de canales externos, analizadas con IA)
model Review {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reserva_id   String             @unique @db.Uuid
  huesped_id   String             @db.Uuid
  canal        CanalReview
  puntuacion   Int
  texto        String?            @db.Text
  sentimiento  SentimientoReview?
  respondido   Boolean            @default(false)
  respuesta    String?            @db.Text
  fecha_review DateTime           @db.Date
  created_at   DateTime           @default(now()) @db.Timestamptz(3)

  reserva Reserva @relation(fields: [reserva_id], references: [id])
  huesped Huesped @relation(fields: [huesped_id], references: [id])

  @@index([huesped_id])
  @@map("reviews")
}

/// Historial de tarifas aplicadas (alimenta el modelo Prophet del ai-service)
model TarifaHistorial {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  habitacion_id   String        @db.Uuid
  fecha           DateTime      @db.Date
  tarifa_base     Decimal       @db.Decimal(10, 2)
  tarifa_aplicada Decimal       @db.Decimal(10, 2)
  ocupacion_pct   Decimal?      @db.Decimal(5, 2)
  canal           CanalReserva?
  fuente          FuenteTarifa  @default(MANUAL)
  created_at      DateTime      @default(now()) @db.Timestamptz(3)

  habitacion Habitacion @relation(fields: [habitacion_id], references: [id])

  @@index([habitacion_id, fecha])
  @@map("tarifas_historial")
}

/// Alertas de mantenimiento generadas por NLP o escalamiento manual
model AlertaMantenimiento {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  habitacion_id String    @db.Uuid
  tipo          String    @db.VarChar(50)
  descripcion   String    @db.Text
  frecuencia    Int       @default(1)
  nivel_alerta  String    @db.VarChar(10)
  activa        Boolean   @default(true)
  resuelta_en   DateTime? @db.Timestamptz(3)
  created_at    DateTime  @default(now()) @db.Timestamptz(3)
  updated_at    DateTime  @updatedAt @db.Timestamptz(3)

  habitacion Habitacion @relation(fields: [habitacion_id], references: [id])

  @@index([habitacion_id])
  @@index([activa])
  @@map("alertas_mantenimiento")
}

/// Mensajes del chatbot concierge IA (Aria)
model ConciergeMessage {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  huesped_id       String   @db.Uuid
  reserva_id       String?  @db.Uuid
  mensaje_huesped  String   @db.Text
  respuesta_aria   String?  @db.Text
  intent_detectado String?  @db.VarChar(50)
  escalado         Boolean  @default(false)
  escalado_motivo  String?  @db.VarChar(200)
  /// reserva_id es nullable (chat pre-stay); columna directa poblada desde el contexto de la request al crear
  local_id         String?  @db.Uuid
  created_at       DateTime @default(now()) @db.Timestamptz(3)

  huesped Huesped  @relation(fields: [huesped_id], references: [id])
  reserva Reserva? @relation(fields: [reserva_id], references: [id])
  local   Local?   @relation(fields: [local_id], references: [id])

  @@index([huesped_id])
  @@index([escalado])
  @@index([local_id])
  @@map("concierge_mensajes")
}

/// Campañas CRM (email y WhatsApp por segmento de huésped)
model CampanaCrm {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre              String          @db.VarChar(255)
  tipo                TipoCampana
  segmento_objetivo   SegmentoCampana @default(TODOS)
  estado              EstadoCampana   @default(BORRADOR)
  fecha_programada    DateTime?       @db.Timestamptz(3)
  fecha_enviada       DateTime?       @db.Timestamptz(3)
  total_destinatarios Int             @default(0)
  total_enviados      Int             @default(0)
  total_abiertos      Int             @default(0)
  mensaje_whatsapp    String?         @db.Text
  asunto_email        String?         @db.VarChar(255)
  cuerpo_email        String?         @db.Text
  personal_id         String?         @db.Uuid
  /// NULL = campaña de cadena; no-NULL = campaña de un solo local
  local_id            String?         @db.Uuid
  created_at          DateTime        @default(now()) @db.Timestamptz(3)
  updated_at          DateTime        @updatedAt @db.Timestamptz(3)

  personal Personal? @relation(fields: [personal_id], references: [id])
  local    Local?    @relation(fields: [local_id], references: [id])

  @@index([estado, segmento_objetivo])
  @@index([local_id])
  @@map("campanas_crm")
}

/// Comprobantes electrónicos SUNAT (boleta / factura)
model Comprobante {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reserva_id    String   @unique @db.Uuid
  tipo          String   @db.VarChar(10)
  serie         String   @db.VarChar(10)
  correlativo   String   @db.VarChar(10)
  fecha_emision DateTime @db.Date
  total         Decimal  @db.Decimal(10, 2)
  xml_generado  String?  @db.Text
  cdr_respuesta String?  @db.Text
  estado        String   @db.VarChar(20)
  pdf_url       String?  @db.Text
  created_at    DateTime @default(now()) @db.Timestamptz(3)

  reserva Reserva @relation(fields: [reserva_id], references: [id])

  @@index([estado])
  @@index([fecha_emision])
  @@map("comprobantes")
}

/// Turnos de recepción (día / noche) con apertura y cierre
model Turno {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo             TipoTurno
  recepcionista_id String      @db.Uuid
  fecha            DateTime    @db.Date
  hora_apertura    DateTime    @default(now()) @db.Timestamptz(3)
  hora_cierre      DateTime?   @db.Timestamptz(3)
  saldo_inicial    Decimal     @default(0) @db.Decimal(10, 2)
  saldo_final      Decimal?    @db.Decimal(10, 2)
  estado           EstadoTurno @default(ABIERTO)
  firma_hash       String?     @db.VarChar(64)
  observaciones    String?     @db.Text
  local_id         String      @db.Uuid
  created_at       DateTime    @default(now()) @db.Timestamptz(3)

  recepcionista Personal          @relation(fields: [recepcionista_id], references: [id])
  local         Local             @relation(fields: [local_id], references: [id])
  gastos_caja   GastoCaja[]
  reporte_cache ReporteTurnoCache?

  @@index([estado])
  @@index([fecha])
  @@index([local_id, fecha])
  @@map("turnos")
}

/// Gastos de caja registrados durante un turno
model GastoCaja {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  turno_id              String   @db.Uuid
  concepto              String   @db.VarChar(200)
  monto                 Decimal  @db.Decimal(10, 2)
  comprobante_proveedor String?  @db.VarChar(50)
  registrado_por_id     String   @db.Uuid
  created_at            DateTime @default(now()) @db.Timestamptz(3)

  turno          Turno    @relation(fields: [turno_id], references: [id], onDelete: Cascade)
  registrado_por Personal @relation("gastos_registrado_por", fields: [registrado_por_id], references: [id])

  @@index([turno_id])
  @@map("gastos_caja")
}

/// Cache del JSON y PDF del reporte de turno cerrado
model ReporteTurnoCache {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  turno_id     String   @unique @db.Uuid
  json_reporte Json
  pdf_url      String?  @db.Text
  generado_at  DateTime @default(now()) @db.Timestamptz(3)

  turno Turno @relation(fields: [turno_id], references: [id], onDelete: Cascade)

  @@map("reporte_turno_cache")
}

/// Bitácora anti-fraude: log de modificaciones y anulaciones
model AuditLog {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entidad            String   @db.VarChar(50)
  entidad_id         String   @db.Uuid
  accion             String   @db.VarChar(50)
  campos_modificados Json?
  actor_email        String?  @db.VarChar(255)
  actor_id           String?  @db.Uuid
  motivo             String?  @db.Text
  /// Poblado best-effort desde el local activo del actor al momento de escribir
  local_id           String?  @db.Uuid
  created_at         DateTime @default(now()) @db.Timestamptz(3)

  local Local? @relation(fields: [local_id], references: [id])

  @@index([entidad, entidad_id])
  @@index([created_at(sort: Desc)])
  @@index([local_id])
  @@map("audit_log")
}

// ─── SaaS: empresas (nivel superior sobre locales) y suscripciones ─────────────

/// Empresa cliente del SaaS — dueña de uno o más locales, con su propio plan y branding.
model Empresa {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre_comercial      String   @db.VarChar(150)
  razon_social          String?  @db.VarChar(200)
  ruc                   String?  @db.VarChar(11)
  email_contacto        String   @db.VarChar(150)
  telefono_contacto     String?  @db.VarChar(20)
  logo_url              String?  @db.Text
  color_primario        String   @default("#1B3A6B") @db.VarChar(7)
  subdominio            String   @unique @db.VarChar(50)
  nombre_sistema        String   @default("Hotelia PMS") @db.VarChar(100)
  plan                  String   @default("basico") @db.VarChar(20)
  max_locales           Int      @default(1)
  max_usuarios          Int      @default(3)
  max_habitaciones_por_local Int @default(30)
  precio_mensual        Decimal  @db.Decimal(10, 2)
  estado                String   @default("activa") @db.VarChar(20)
  fecha_inicio_contrato DateTime @default(now()) @db.Date
  fecha_proximo_pago    DateTime @db.Date
  dias_gracia           Int      @default(5)
  ultima_suspension_at  DateTime? @db.Timestamptz(3)
  motivo_suspension     String?  @db.Text
  notas_internas        String?  @db.Text
  created_at            DateTime @default(now()) @db.Timestamptz(3)
  updated_at             DateTime @updatedAt @db.Timestamptz(3)

  locales  Local[]
  personal Personal[]
  pagos    EmpresaPago[]

  @@map("empresas")
}

/// Historial de pagos de suscripción de una empresa (registrados manualmente por el superadmin de plataforma)
model EmpresaPago {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresa_id                String    @db.Uuid
  monto                     Decimal   @db.Decimal(10, 2)
  periodo                   String    @db.VarChar(7)
  fecha_pago                DateTime? @db.Date
  metodo                    String?   @db.VarChar(30)
  referencia                String?   @db.VarChar(100)
  estado                    String    @default("pendiente") @db.VarChar(20)
  registrado_por_superadmin Boolean   @default(true)
  notas                     String?   @db.Text
  created_at                DateTime  @default(now()) @db.Timestamptz(3)

  empresa Empresa @relation(fields: [empresa_id], references: [id], onDelete: Cascade)

  @@index([empresa_id])
  @@map("empresas_pagos")
}

// ─── Multi-local: locales, roles y permisos granulares ─────────────────────────

/// Sede / local dentro de la cadena hotelera
model Local {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresa_id     String?  @db.Uuid
  codigo         String   @unique @db.VarChar(30)
  nombre         String   @db.VarChar(150)
  ruc            String?  @db.VarChar(11)
  razon_social   String?  @db.VarChar(200)
  direccion      String?  @db.Text
  ciudad         String?  @db.VarChar(100)
  pais           String   @default("Perú") @db.VarChar(50)
  timezone       String   @default("America/Lima") @db.VarChar(50)
  moneda_default String   @default("PEN") @db.VarChar(3)
  telefono       String?  @db.VarChar(20)
  email          String?  @db.VarChar(150)
  color_tema     String   @default("#1B3A6B") @db.VarChar(7)
  estado         String   @default("activo") @db.VarChar(20)
  razon_pausa    String?  @db.Text
  activo         Boolean  @default(true)
  created_at     DateTime @default(now()) @db.Timestamptz(3)
  updated_at     DateTime @updatedAt @db.Timestamptz(3)

  empresa                Empresa?      @relation(fields: [empresa_id], references: [id])
  usuario_locales       UsuarioLocal[]
  contabilidad_asientos ContabilidadAsiento[]
  contabilidad_config   ContabilidadConfig?
  tipos_habitacion      TipoHabitacionCustom[]
  habitaciones          Habitacion[]
  reglas_temporada      ReglaTemporada[]
  canal_sync_log        CanalSyncLog[]
  concierge_mensajes    ConciergeMessage[]
  campanas_crm          CampanaCrm[]
  turnos                Turno[]
  audit_log             AuditLog[]

  @@index([empresa_id])
  @@map("locales")
}

/// Rol del sistema (catálogo estático: superadmin, dueno, gerente_local, recepcionista, housekeeping, mantenimiento, almacen, contabilidad)
model Rol {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo         String   @unique @db.VarChar(30)
  nombre         String   @db.VarChar(80)
  descripcion    String?  @db.Text
  /// true = superadmin/dueno: opera sobre cualquier local sin fila en usuario_locales
  alcance_global Boolean  @default(false)
  es_sistema     Boolean  @default(true)
  created_at     DateTime @default(now()) @db.Timestamptz(3)

  personal        Personal[]
  roles_permisos  RolPermiso[]
  usuario_locales UsuarioLocal[]

  @@map("roles")
}

/// Permiso granular (código dot-namespaced, ej. "reservas.gestionar")
model Permiso {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo      String  @unique @db.VarChar(60)
  nombre      String  @db.VarChar(100)
  modulo      String  @db.VarChar(50)
  descripcion String? @db.Text

  roles_permisos RolPermiso[]

  @@index([modulo])
  @@map("permisos")
}

/// Permisos por defecto de cada rol (catálogo, no por usuario)
model RolPermiso {
  rol_id     String @db.Uuid
  permiso_id String @db.Uuid

  rol     Rol     @relation(fields: [rol_id], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permiso_id], references: [id], onDelete: Cascade)

  @@id([rol_id, permiso_id])
  @@map("roles_permisos")
}

/// Grant: acceso de un usuario a un local específico con un rol y permisos custom
model UsuarioLocal {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personal_id        String   @db.Uuid
  local_id           String   @db.Uuid
  rol_id             String   @db.Uuid
  es_local_principal Boolean  @default(true)
  puede_operar       Boolean  @default(true)
  puede_ver_info     Boolean  @default(true)
  /// Permisos adicionales sobre el rol base (array de códigos de permisos.codigo)
  permisos_extra     Json     @default("[]")
  /// Permisos quitados del rol base (array de códigos de permisos.codigo)
  permisos_removidos Json     @default("[]")
  activo             Boolean  @default(true)
  created_at         DateTime @default(now()) @db.Timestamptz(3)

  personal Personal @relation(fields: [personal_id], references: [id], onDelete: Cascade)
  local    Local    @relation(fields: [local_id], references: [id], onDelete: Cascade)
  rol      Rol      @relation(fields: [rol_id], references: [id])

  @@unique([personal_id, local_id])
  @@index([local_id])
  @@map("usuario_locales")
}

// ─── Contabilidad ────────────────────────────────────────────────────────────

/// Asiento contable (manual o generado automáticamente desde pagos/folio)
model ContabilidadAsiento {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  local_id        String              @db.Uuid
  fecha           DateTime            @db.Date
  numero_asiento  String?             @db.VarChar(20)
  tipo            TipoAsientoContable
  concepto        String              @db.Text
  debe            Decimal             @default(0) @db.Decimal(12, 2)
  haber           Decimal             @default(0) @db.Decimal(12, 2)
  cuenta_contable String?             @db.VarChar(20)
  referencia_id   String?             @db.Uuid
  referencia_tipo String?             @db.VarChar(30)
  creado_por_id   String?             @db.Uuid
  created_at      DateTime            @default(now()) @db.Timestamptz(3)

  local Local @relation(fields: [local_id], references: [id])

  @@index([local_id, fecha])
  @@map("contabilidad_asientos")
}

/// Configuración contable/SUNAT por local (incluye correlativos de comprobantes)
model ContabilidadConfig {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  local_id             String   @unique @db.Uuid
  plan_cuentas         Json     @default("{}")
  periodo_fiscal       String?  @db.VarChar(7)
  moneda_principal     String   @default("PEN") @db.VarChar(3)
  sistema_contable     String   @default("manual") @db.VarChar(50)
  serie_boleta         String   @default("B001") @db.VarChar(10)
  correlativo_boleta   Int      @default(0)
  serie_factura        String   @default("F001") @db.VarChar(10)
  correlativo_factura  Int      @default(0)
  created_at           DateTime @default(now()) @db.Timestamptz(3)

  local Local @relation(fields: [local_id], references: [id])

  @@map("contabilidad_config")
}
