# ══════════════════════════════════════════════════════════════════════════════
# Hotel PMS — Production Environment Template
# Copy to .env.prod and fill in real values. NEVER commit .env.prod to git.
# ══════════════════════════════════════════════════════════════════════════════

# ─── Database ────────────────────────────────────────────────────────────────

POSTGRES_USER=hotel_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=hotel_prod
DATABASE_URL=postgresql://hotel_user:CHANGE_ME_STRONG_PASSWORD@postgres:5432/hotel_prod

# ─── Redis ───────────────────────────────────────────────────────────────────

REDIS_URL=redis://:CHANGE_ME_REDIS_PASS@redis:6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASS

# ─── JWT ─────────────────────────────────────────────────────────────────────

# Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_MIN_64_CHARS_RANDOM_STRING
JWT_EXPIRES_IN=8h

# ─── QR Check-in ─────────────────────────────────────────────────────────────

QR_SECRET=CHANGE_ME_QR_SECRET

# ─── IA / AI Service ─────────────────────────────────────────────────────────

IA_SECRET_KEY=CHANGE_ME_IA_KEY
IA_SERVICE_URL=http://ia-service:8001
BACKEND_INTERNAL_URL=http://backend:3000
# Generate with: openssl rand -hex 32
BACKEND_SERVICE_TOKEN=CHANGE_ME_SERVICE_TOKEN

# ─── Payments — Niubiz (Peru) ────────────────────────────────────────────────

NIUBIZ_MERCHANT_ID=
NIUBIZ_USER=
NIUBIZ_PASSWORD=
NIUBIZ_ENV=production

# ─── Payments — Stripe ───────────────────────────────────────────────────────

STRIPE_SECRET_KEY=

# ─── SUNAT / Electronic Billing ──────────────────────────────────────────────

SUNAT_RUC=
SUNAT_USUARIO_SOL=
SUNAT_CLAVE_SOL=
SUNAT_ENV=produccion
SUNAT_CERT_PATH=/certs/cert.pem
SUNAT_CERT_PASS=
SUNAT_NOMBRE_COMERCIAL=
SUNAT_DIRECCION=

# ─── WhatsApp (Meta Business API) ────────────────────────────────────────────

WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# ─── OTA Webhooks ────────────────────────────────────────────────────────────

WEBHOOK_SECRET_BOOKING=
WEBHOOK_SECRET_EXPEDIA=
WEBHOOK_SECRET_AIRBNB=

# ─── Exchange Rates ──────────────────────────────────────────────────────────

TIPO_CAMBIO_EUR_PEN=4.10
TIPO_CAMBIO_USD_PEN=3.75

# ─── Domain & URLs ───────────────────────────────────────────────────────────

DOMAIN=hotel.tudominio.com
FRONTEND_URL=https://hotel.tudominio.com
RECEPCION_PHONE=+51999000000

# ─── Anthropic (Concierge IA — Aria) ─────────────────────────────────────────

ANTHROPIC_API_KEY=

# ─── n8n Automation ──────────────────────────────────────────────────────────

N8N_URL=http://n8n:5678
N8N_WEBHOOK_SECRET=CHANGE_ME_N8N_SECRET

# ─── App ─────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3000
