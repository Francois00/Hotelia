# ── Stage 1: build deps ─────────────────────────────────────────────────────
FROM python:3.11-slim AS builder

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip install --prefix=/install -r requirements.txt

# ── Stage 2: runner ─────────────────────────────────────────────────────────
FROM python:3.11-slim AS runner

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    NODE_ENV=production

RUN addgroup --gid 1001 python && adduser --uid 1001 --gid 1001 --no-create-home python

COPY --from=builder /install /usr/local
COPY . .

# Create empty makefile for cmdstanpy (Prophet requirement)
RUN mkdir -p /root/.cmdstan && \
    find /usr/local/lib -path "*/cmdstanpy/stan/lib/stan_math/lib/tbb/build" -exec sh -c 'touch {}/Makefile' \; 2>/dev/null || true

RUN chown -R python:python /app
USER python

EXPOSE 8001

HEALTHCHECK --interval=60s --timeout=30s --start-period=120s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8001/ia/v1/health')" || exit 1

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "2"]
