      "id": "cc000002-0000-0000-0000-000000000001",
      "name": "1. Recibir mensaje",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "wpp-concierge-webhook"
    },
    {
      "parameters": {
        "jsCode": "// Soporta DOS formatos:\n// 1. Test page:  { mensaje, session_id }\n// 2. Meta WPP:   { entry:[{changes:[{value:{messages:[...]}}]}] }\nconst body = $input.first().json.body || $input.first().json;\n\nif (body.mensaje && (body.session_id || body.telefono)) {\n  return [{ json: {\n    valido: 'true',\n    telefono: String(body.session_id || body.telefono),\n    mensaje: String(body.mensaje).trim(),\n    modo: 'test'\n  }}];\n}\n\nconst entry = body?.entry?.[0];\nconst value = entry?.changes?.[0]?.value;\nconst msg = value?.messages?.[0];\n\nif (!msg || msg.type !== 'text' || !msg.text?.body) {\n  return [{ json: { valido: 'false', modo: 'wpp', telefono: '', mensaje: '' } }];\n}\n\nreturn [{ json: {\n  valido: 'true',\n  telefono: String(msg.from),\n  mensaje: String(msg.text.body).trim(),\n  modo: 'wpp'\n}}];"
      },
      "id": "cc000002-0000-0000-0000-000000000002",
      "name": "2. Extraer mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [{ "value1": "={{ $json.valido }}", "operation": "equal", "value2": "true" }]
        }
      },
      "id": "cc000002-0000-0000-0000-000000000003",
      "name": "3. Mensaje valido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:3000/api/v1/n8n/concierge",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-n8n-token", "value": "n8n_hotelia_2025" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ mensaje: $json.mensaje, session_id: $json.telefono }) }}",
        "continueOnFail": true
      },
      "id": "cc000002-0000-0000-0000-000000000004",
      "name": "4. Concierge IA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [900, 200]
    },
    {
      "parameters": {
        "jsCode": "const concierge = $input.first().json;\nconst extractData = $('2. Extraer mensaje').first().json;\n\nconst respuesta = concierge.respuesta || 'Sin respuesta del concierge';\nconst paso = concierge.paso_actual || 'inicio';\nconst modo = extractData.modo || 'test';\nconst telefono = extractData.telefono || '';\nconst tiempoMs = concierge.tiempo_ms || 0;\n\nreturn [{ json: {\n  respuesta,\n  paso_actual: paso,\n  modo,\n  telefono,\n  tiempo_ms: tiempoMs,\n  modelo: 'llama3'\n}}];"
      },
      "id": "cc000002-0000-0000-0000-000000000005",
      "name": "5. Preparar respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 200]
    },
