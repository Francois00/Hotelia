{
  "name": "Checkout Automatico",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 30 }] }
      },
      "id": "bb000002-0000-0000-0000-000000000001",
      "name": "Cron 30min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://backend:3000/api/v1/reservas",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Authorization", "value": "Bearer change_me_backend_token_dev" }]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "estado", "value": "CHECKIN_REALIZADO" },
            { "name": "limit",  "value": "100" }
          ]
        }
      },
      "id": "bb000002-0000-0000-0000-000000000002",
      "name": "Get Reservas en Checkin",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [400, 300]
    },
    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst today = now.toISOString().slice(0,10);\nconst hour = now.getHours();\nconst reservas = $input.all()[0].json.data || [];\nconst toCheckout = reservas.filter(r => r.fecha_salida === today && hour >= 12);\nreturn toCheckout.map(r => ({ json: r }));"
      },
      "id": "bb000002-0000-0000-0000-000000000003",
      "name": "Filtrar Checkout Hoy >=12h",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [600, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://backend:3000/api/v1/reservas/{{ $json.id }}/folio/resumen",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Authorization", "value": "Bearer change_me_backend_token_dev" }]
        }
      },
      "id": "bb000002-0000-0000-0000-000000000004",
      "name": "Get Folio Saldo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [800, 300],
      "continueOnFail": true
    },
    {
      "parameters": {
        "conditions": {
          "number": [{ "value1": "={{ $json.saldo_pendiente }}", "operation": "equal", "value2": 0 }]
        }
      },
      "id": "bb000002-0000-0000-0000-000000000005",
      "name": "Saldo = 0?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1000, 300]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=http://backend:3000/api/v1/reservas/{{ $('Filtrar Checkout Hoy >=12h').item.json.id }}/estado",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Authorization", "value": "Bearer change_me_backend_token_dev" }]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [{ "name": "estado", "value": "CHECKOUT_REALIZADO" }]
        }
      },
      "id": "bb000002-0000-0000-0000-000000000006",
      "name": "Checkout Realizado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1200, 200],
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://backend:3000/api/v1/internal/notificaciones",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "X-Service-Token", "value": "change_me_backend_token_dev" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ tipo: 'WHATSAPP_SALDO', huesped_id: $('Filtrar Checkout Hoy >=12h').item.json.huesped_id, plantilla: 'saldo_pendiente', variables: { monto: $json.saldo_pendiente, habitacion: $('Filtrar Checkout Hoy >=12h').item.json.habitacion?.numero } }) }}"
      },
      "id": "bb000002-0000-0000-0000-000000000007",
      "name": "Notificar Saldo Pendiente",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1200, 400],
      "continueOnFail": true
    }
  ],
  "connections": {
    "Cron 30min": {
      "main": [[{ "node": "Get Reservas en Checkin", "type": "main", "index": 0 }]]
    },
    "Get Reservas en Checkin": {
      "main": [[{ "node": "Filtrar Checkout Hoy >=12h", "type": "main", "index": 0 }]]
    },
    "Filtrar Checkout Hoy >=12h": {
      "main": [[{ "node": "Get Folio Saldo", "type": "main", "index": 0 }]]
    },
    "Get Folio Saldo": {
      "main": [[{ "node": "Saldo = 0?", "type": "main", "index": 0 }]]
    },
    "Saldo = 0?": {
      "main": [
        [{ "node": "Checkout Realizado",       "type": "main", "index": 0 }],
        [{ "node": "Notificar Saldo Pendiente", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "id": "checkout-automatico-flow-002",
  "versionId": "2a2b3c4d-0002-0002-0002-000000000002",
  "meta": { "instanceId": "hotel-pms" }
}
